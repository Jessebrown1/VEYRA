generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  preferredName String?
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companions           Companion[]
  subscription         Subscription?
  notificationSettings NotificationSettings?
  locationSettings     LocationSettings?
  sentNotifications    SentNotification[]
}

model Companion {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  relationshipId    String
  personalityTraits Json
  preferredUserName String
  preferredTermId   String
  wallpaperId       String?
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversations Conversation[]
  memories      Memory[]
  avatarConfig  AvatarConfig?

  @@index([userId])
}

model Conversation {
  id          String    @id @default(uuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages Message[]

  @@index([companionId])
}

enum MessageSender {
  user
  companion
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  memories Memory[]

  @@index([conversationId])
}

enum MemoryCategory {
  identity
  preferences
  interests
  relationships
  goals
  important_dates
  routines
  locations
  education
  work
  personal_facts
  conversation_context
}

model Memory {
  id              String                       @id @default(uuid())
  userId          String
  companionId     String
  companion       Companion                    @relation(fields: [companionId], references: [id], onDelete: Cascade)
  category        MemoryCategory
  content         String
  importance      Float                        @default(0.5)
  confidence      Float                        @default(0.5)
  sourceMessageId String?
  sourceMessage   Message?                      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  isActive        Boolean                      @default(true)
  embedding       Unsupported("vector(768)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([companionId])
  @@index([userId])
}

model WallpaperAsset {
  id            String   @id @default(uuid())
  name          String
  category      String
  assetPath     String
  thumbnailPath String?
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

enum AvatarAssetCategory {
  skin
  hair
  eyes
  outfit
  accessory
}

model AvatarAsset {
  id            String              @id @default(uuid())
  category      AvatarAssetCategory
  name          String
  assetPath     String
  thumbnailPath String?
  isPremium     Boolean             @default(false)
  metadata      Json?
  isActive      Boolean             @default(true)
}

model AvatarConfig {
  id               String    @id @default(uuid())
  companionId      String    @unique
  companion        Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  skinAssetId      String?
  hairAssetId      String?
  eyeAssetId       String?
  outfitAssetId    String?
  accessoryAssetId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum SubscriptionStatus {
  inactive
  active
  trial
  expired
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String             @default("mock")
  productId String?
  status    SubscriptionStatus @default(inactive)
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model NotificationSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  companionCheckins Boolean  @default(true)
  sleepReminders    Boolean  @default(true)
  quietHoursEnabled Boolean  @default(false)
  quietStart        String?
  quietEnd          String?
  frequency         String   @default("normal")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LocationSettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  permissionType String   @default("none")
  lastArea       String?
  updatedAt      DateTime @updatedAt
}

model SentNotification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId String
  type        String
  content     String
  createdAt   DateTime @default(now())

  @@index([userId])
}
