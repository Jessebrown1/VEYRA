MODEL_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Used when MODEL_PROVIDER=groq (e.g. on Render, where Ollama isn't practical
# to run) — handles chat replies, much higher free-tier limits than Gemini.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Used for embeddings whenever MODEL_PROVIDER is groq or gemini — Groq has no
# embeddings endpoint, so this stays required even when Groq handles chat.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIMENSIONS=768

PORT=8000
